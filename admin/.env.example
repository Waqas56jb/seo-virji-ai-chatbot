# Admin configuration. PUBLIC build-time values only — never put secrets here.

# Base URL of the SEO Virji API. Leave empty in development: Vite proxies /api to the server.
# Production example: VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# Where the dev/preview proxy forwards /api (the local server's PORT).
VITE_API_PROXY_TARGET=http://localhost:4100

# Where the "Preview chatbot" button points.
VITE_CLIENT_URL=http://localhost:5173
