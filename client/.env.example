# Client (chatbot) configuration. These are PUBLIC build-time values — never put secrets here.

# Base URL of the SEO Virji API. Leave empty in development: Vite proxies /api to the server.
# For production builds (and the embeddable widget.js), set the deployed API URL, e.g.
# VITE_API_BASE_URL=https://api.your-domain.com
VITE_API_BASE_URL=

# Where the dev/preview proxy forwards /api (the local server's PORT).
VITE_API_PROXY_TARGET=http://localhost:4100

# Bot identifier (the embed script can also pass data-bot-id).
VITE_BOT_ID=seo-virji
