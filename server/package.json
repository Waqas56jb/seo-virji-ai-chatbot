{
  "name": "seo-virji-chatbot-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "SEO Virji AI Chatbot API — Express + OpenAI + Supabase (pgvector) + RAG.",
  "main": "src/server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run --dir src/tests --exclude \"**/integration.test.js\" --exclude \"**/crawler-sync.test.js\"",
    "test:integration": "vitest run src/tests/integration.test.js",
    "db:migrate": "node scripts/migrate.js",
    "db:verify": "node scripts/verify-database.js",
    "crawl": "node scripts/crawl-website.js",
    "embeddings:rebuild": "node scripts/rebuild-embeddings.js",
    "admin:create": "node scripts/create-admin.js",
    "health": "node scripts/test-connections.js",
    "lint": "node scripts/lint.js",
    "test:crawler": "vitest run src/tests/crawler-sync.test.js",
    "test:all": "npm test && npm run test:crawler && npm run test:integration"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@vercel/functions": "^2.2.13",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "openai": "^4.77.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
