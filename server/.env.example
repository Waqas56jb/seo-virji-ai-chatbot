# SEO Virji API — copy to `.env` and fill in. NEVER commit .env or put these values in client/admin.

# --- Server ---------------------------------------------------------------
PORT=4100
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Extra allowed browser origins (comma-separated): the websites that embed the widget.
ALLOWED_ORIGINS=https://seovirji.com,https://www.seovirji.com

# --- Supabase (Project Settings → API / Database) ---------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Session pooler connection string. URL-encode special characters in the password (! → %21).
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_POOL_MAX=8

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector column created by the migration (text-embedding-3-small → 1536).
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_TEMPERATURE=0.6
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=2
# Optional: USD per 1M tokens, used only for cost estimates in analytics. Leave empty to skip.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
OPENAI_PRICE_EMBEDDING_PER_1M=

# --- Business -----------------------------------------------------------------
SEO_VIRJI_WEBSITE_URL=https://seovirji.com/
SEO_VIRJI_BUSINESS_NAME=SEO Virji
# Fallback WhatsApp number (digits, with country code). The admin Settings value takes priority.
SEO_VIRJI_WHATSAPP_NUMBER=

# --- Admin auth -----------------------------------------------------------------
# Long random string, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_DAYS=7
# 'lax' when the admin is served from the same site as the API; 'none' for cross-site (requires HTTPS).
COOKIE_SAMESITE=lax

# --- Crawler --------------------------------------------------------------------
CRAWLER_MAX_PAGES=60
CRAWLER_MAX_DEPTH=3
CRAWLER_REQUEST_DELAY_MS=800
CRAWLER_TIMEOUT_MS=15000
CRAWLER_MAX_BYTES=3000000
# Additional approved hosts (the website host and its www variant are always allowed).
CRAWLER_ALLOWED_HOSTS=
# Daily re-sync (cron syntax, server time). Set CRAWLER_SCHEDULE_ENABLED=false to disable.
CRAWLER_SCHEDULE=0 3 * * *
CRAWLER_SCHEDULE_ENABLED=true

# --- Chat, RAG & limits -----------------------------------------------------------
CHAT_MEMORY_LIMIT=20
CHAT_SESSION_DAYS=30
RAG_TOP_K=6
RAG_SIMILARITY_THRESHOLD=0.3
MAX_MESSAGE_LENGTH=1000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
# Delete conversations older than N days (0 = keep forever).
DATA_RETENTION_DAYS=0
